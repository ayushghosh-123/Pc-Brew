# ===================================================================
# PC BREW (pcbrew) — ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================================
# Copy this file to .env or run: pcbrew setup

# -------------------------------------------------------------------
# 1. AI PROVIDER SELECTION (Optional: auto-detected if omitted)
# Options: openrouter | openai | anthropic | google
# -------------------------------------------------------------------
AI_PROVIDER=openrouter

# Custom Model Override (Optional: defaults to provider standard)
# AI_MODEL=claude-3-5-sonnet-latest

# -------------------------------------------------------------------
# 2. OPENROUTER CONFIGURATION (Default)
# Get key: https://openrouter.ai/keys
# -------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_DEFAULT_MODEL=openrouter/free

# -------------------------------------------------------------------
# 3. OPENAI CONFIGURATION (Optional alternative)
# Get key: https://platform.openai.com/api-keys
# -------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -------------------------------------------------------------------
# 4. ANTHROPIC CLAUDE CONFIGURATION (Optional alternative)
# Get key: https://console.anthropic.com/
# -------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# -------------------------------------------------------------------
# 5. GOOGLE GEMINI CONFIGURATION (Optional alternative)
# Get key: https://aistudio.google.com/app/apikey
# -------------------------------------------------------------------
GEMINI_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

# -------------------------------------------------------------------
# 6. TELEGRAM INTEGRATION (Optional)
# Bot token from @BotFather, numeric ID from @userinfobot
# -------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# -------------------------------------------------------------------
# 7. WHATSAPP LAPTOP CONTROLLER (Optional)
# Owner phone number with country code (e.g. 919876543210)
# -------------------------------------------------------------------
WHATSAPP_OWNER_NUMBER=

# -------------------------------------------------------------------
# 8. FIRECRAWL WEB SCRAPING & SEARCH (Optional)
# Get key: https://www.firecrawl.dev/
# -------------------------------------------------------------------
FIRECRAWL_API_KEY=
